<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pcd_config_form" model="ir.ui.view">
        <field name="name">product.price.change.digest.config.form</field>
        <field name="model">product.price.change.digest.config</field>
        <field name="arch" type="xml">
            <form string="Fiyat Değişim Bildirimi Ayarları">
                <header>
                    <button name="action_save" type="object" string="Kaydet" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Fiyat Değişim Bildirimi</h1>
                    </div>
                    <group>
                        <group string="Genel">
                            <field name="enabled"/>
                            <field name="allow_real_send"/>
                            <field name="slots"/>
                            <field name="window_min"/>
                            <field name="tz"/>
                        </group>
                        <group string="Alıcılar">
                            <field name="test_recipient"/>
                            <field name="sender"/>
                            <field name="recipients"/>
                        </group>
                        <group string="İçerik / Filtre">
                            <field name="price_threshold"/>
                            <field name="display_limit"/>
                            <field name="excluded_warehouses"/>
                            <field name="report_lang"/>
                        </group>
                        <group string="Bakım">
                            <field name="cleanup_retention_days"/>
                        </group>
                    </group>
                    <div class="text-muted" style="margin-top:10px;">
                        Not: "Test Alıcısı" dolu ise mail SADECE oraya gider. Gerçek listeye göndermek için
                        Test Alıcısı boş + Gerçek Gönderim "Evet" + Bildirim Sistemi "Açık" olmalı.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pcd_settings" model="ir.actions.act_window">
        <field name="name">Fiyat Değişim Bildirimi</field>
        <field name="res_model">product.price.change.digest.config</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_pcd_settings_root"
              name="Fiyat Değişim Bildirimi"
              parent="base.menu_administration"
              action="action_pcd_settings"
              sequence="99"/>
</odoo>
