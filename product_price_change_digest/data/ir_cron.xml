<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Slot gönderimi: her dakika kontrol eder, sadece slot saatinde ve enabled=1 ise gönderir. -->
    <record id="ir_cron_price_change_digest" model="ir.cron">
        <field name="name">Fiyat Değişim Bildirimi - Slot Gönderimi</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_price_change_digest()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>

    <!-- Temizlik: eski FD/FD-LINK aksiyonları ve CSV eklerini siler. KAPALI gelir;
         önce dry-run ile doğrulanıp elle açılır. -->
    <record id="ir_cron_price_change_cleanup" model="ir.cron">
        <field name="name">Fiyat Değişim Bildirimi - Temizlik</field>
        <field name="model_id" ref="model_product_price_change_cleanup"/>
        <field name="state">code</field>
        <field name="code">model.cron_cleanup()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="False"/>
    </record>
</odoo>
